# Multi-Claude 3.0 Database Configuration
# PostgreSQL connection settings
# Copy this file to .env and update with your actual values

DB_HOST=localhost
DB_PORT=5432
DB_NAME=multi_claude_system
DB_USER=your_db_user
DB_PASSWORD=your_db_password

# Full database connection URL
DATABASE_URL=postgresql://your_db_user:your_db_password@localhost:5432/multi_claude_system

# PostgreSQL binary path (adjust based on your installation)
# macOS Homebrew: /opt/homebrew/opt/postgresql@16/bin:$PATH
# Linux: Usually already in PATH
# Windows: C:\Program Files\PostgreSQL\16\bin
PATH=/opt/homebrew/opt/postgresql@16/bin:$PATH
