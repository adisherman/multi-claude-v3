# Multi-Claude Backend - Docker Ignore

# Node modules (will be installed in container)
node_modules
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Build outputs (will be generated in container)
dist
build
*.js
*.d.ts
*.js.map
*.d.ts.map

# Development files
.env
.env.local
.env.*.local
*.log

# Testing
coverage
.nyc_output
*.lcov

# IDE and Editor files
.vscode
.idea
*.swp
*.swo
*~
.DS_Store

# Git
.git
.gitignore
.gitattributes

# Documentation (not needed at runtime)
README.md
*.md
docs/

# CI/CD
.github
.gitlab-ci.yml

# Docker files
Dockerfile
.dockerignore
docker-compose.yml

# Temporary files
tmp
temp
*.tmp

# Logs
logs
*.log
